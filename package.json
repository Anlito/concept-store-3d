{
  "name": "concept-store-3d",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-icons.mjs && node scripts/build-library.mjs && tsc --noEmit && vite build && vite build --mode diagnostic",
    "serve": "node scripts/serve.mjs dist",
    "package": "npm run build && node scripts/build-fiche.mjs && node scripts/package.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
